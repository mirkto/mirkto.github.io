# Used by Netlify / Cloudflare Pages. GitHub Pages ignores this — SW + ?v= handle cache there.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/whisper-worker.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/
  Cache-Control: no-cache, max-age=0, must-revalidate

/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
